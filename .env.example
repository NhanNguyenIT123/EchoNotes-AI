ECHONOTES_DATABASE_URL=postgresql+psycopg://echonotes:echonotes@127.0.0.1:5432/echonotes
ECHONOTES_DATABASE_FALLBACK=sqlite
ECHONOTES_REDIS_URL=redis://127.0.0.1:6379/0
ECHONOTES_JOB_BACKEND=local
ECHONOTES_RQ_QUEUE=echonotes
ECHONOTES_STORAGE_PROVIDER=local
ECHONOTES_LOCAL_STORAGE_DIR=data/cloud_artifacts
ECHONOTES_VECTOR_BACKEND=auto
ECHONOTES_EMBED_MODEL=nomic-embed-text
ECHONOTES_DIARIZATION_PROVIDER=heuristic
